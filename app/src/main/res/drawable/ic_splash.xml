<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash-screen mark ——「暗夜声线」波形（288dp 画布，108 视口 => 图形自动缩放）。

    平台启动图会把这张 drawable 居中画在 windowSplashScreenBackground 的平色上，
    所以这里只画波形本体（含辉光），不画方形底色场——否则圆形区域内会露出一块方色。
    同一张 drawable 也被冷启动动画复用（LaunchSplash.kt 按 288dp 居中绘制），
    因此"平台启动图最后一帧 == 应用内动画第一帧"这个无缝契约继续成立。
    几何与 ic_launcher_foreground 完全一致：跨度 x 25–78、y 31–70。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 辉光外层 -->
    <path
        android:pathData="M25,54 C30.5,54 32,38 38,38 C44,38 45.5,70 51.5,70 C57.5,70 59,31 65,31 C71,31 72.5,54 78,54"
        android:strokeWidth="13"
        android:strokeAlpha="0.05"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="25" android:startY="54"
                android:endX="78" android:endY="54">
                <item android:offset="0" android:color="#2FE3D2" />
                <item android:offset="0.5" android:color="#74EBFF" />
                <item android:offset="1" android:color="#FFC46B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 辉光内层 -->
    <path
        android:pathData="M25,54 C30.5,54 32,38 38,38 C44,38 45.5,70 51.5,70 C57.5,70 59,31 65,31 C71,31 72.5,54 78,54"
        android:strokeWidth="7"
        android:strokeAlpha="0.09"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="25" android:startY="54"
                android:endX="78" android:endY="54">
                <item android:offset="0" android:color="#2FE3D2" />
                <item android:offset="0.5" android:color="#74EBFF" />
                <item android:offset="1" android:color="#FFC46B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 主线 -->
    <path
        android:pathData="M25,54 C30.5,54 32,38 38,38 C44,38 45.5,70 51.5,70 C57.5,70 59,31 65,31 C71,31 72.5,54 78,54"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="25" android:startY="54"
                android:endX="78" android:endY="54">
                <item android:offset="0" android:color="#2FE3D2" />
                <item android:offset="0.5" android:color="#74EBFF" />
                <item android:offset="1" android:color="#FFC46B" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
