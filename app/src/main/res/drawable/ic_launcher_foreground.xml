<?xml version="1.0" encoding="utf-8"?>
<!--
    Original OneAsmr brand mark: a stylized headphone (arc band + two ear
    cups), drawn from scratch as vector geometry — no third-party/copyrighted
    assets (plan Task 28). Glyph sits inside the adaptive-icon safe zone
    (central 66dp circle of the 108dp canvas). Light lavender on the dark
    brand background; the same geometry is reused for the monochrome layer
    (themed icons, API 33+) and the splash screen mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Headband: arc from the left cup top to the right cup top. -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M34,49 A20,20 0 0 1 74,49"
        android:strokeColor="#E8DEF8"
        android:strokeLineCap="round"
        android:strokeWidth="6" />
    <!-- Left ear cup (rounded rectangle). -->
    <path
        android:fillColor="#E8DEF8"
        android:pathData="M33,52 a3,3 0 0 1 3,-3 h4 a3,3 0 0 1 3,3 v14 a3,3 0 0 1 -3,3 h-4 a3,3 0 0 1 -3,-3 z" />
    <!-- Right ear cup (rounded rectangle, mirrored). -->
    <path
        android:fillColor="#E8DEF8"
        android:pathData="M65,52 a3,3 0 0 1 3,-3 h4 a3,3 0 0 1 3,3 v14 a3,3 0 0 1 -3,3 h-4 a3,3 0 0 1 -3,-3 z" />
</vector>
