<?xml version="1.0" encoding="utf-8"?>
<!--
    OneAsmr launcher glyph ——「暗夜声线」波形（C3 完成度）

    一条青绿 → 青 → 暖金的声波曲线，同一路径描三遍做辉光（13/0.05、7/0.09、4/1），
    是"没有模糊滤镜也能发光"的做法。
    渐变描边用 aapt 内联 gradient（Android 矢量支持渐变描边）。
    几何：跨度 x 25–78、y 31–70，最外圈距画布中心 ≈30dp，完全落在自适应图标
    安全区（中心 66dp 圆）内，任何遮罩都不会切到主体。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 辉光外层 -->
    <path
        android:pathData="M27.5,57.5 C33,57.5 34.5,41.5 40.5,41.5 C46.5,41.5 48,73.5 54,73.5 C60,73.5 61.5,34.5 67.5,34.5 C73.5,34.5 75,57.5 80.5,57.5"
        android:strokeWidth="13"
        android:strokeAlpha="0.05"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="27.5" android:startY="57.5"
                android:endX="80.5" android:endY="57.5">
                <item android:offset="0" android:color="#2FE3D2" />
                <item android:offset="0.5" android:color="#74EBFF" />
                <item android:offset="1" android:color="#FFC46B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 辉光内层 -->
    <path
        android:pathData="M27.5,57.5 C33,57.5 34.5,41.5 40.5,41.5 C46.5,41.5 48,73.5 54,73.5 C60,73.5 61.5,34.5 67.5,34.5 C73.5,34.5 75,57.5 80.5,57.5"
        android:strokeWidth="7"
        android:strokeAlpha="0.09"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="27.5" android:startY="57.5"
                android:endX="80.5" android:endY="57.5">
                <item android:offset="0" android:color="#2FE3D2" />
                <item android:offset="0.5" android:color="#74EBFF" />
                <item android:offset="1" android:color="#FFC46B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 主线 -->
    <path
        android:pathData="M27.5,57.5 C33,57.5 34.5,41.5 40.5,41.5 C46.5,41.5 48,73.5 54,73.5 C60,73.5 61.5,34.5 67.5,34.5 C73.5,34.5 75,57.5 80.5,57.5"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="27.5" android:startY="57.5"
                android:endX="80.5" android:endY="57.5">
                <item android:offset="0" android:color="#2FE3D2" />
                <item android:offset="0.5" android:color="#74EBFF" />
                <item android:offset="1" android:color="#FFC46B" />
            </gradient>
