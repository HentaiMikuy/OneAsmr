<?xml version="1.0" encoding="utf-8"?>
<!--
    Themed-icon (API 33+) monochrome layer for the「暗夜声线」mark.

    The launcher tints this drawable with one colour taken from the wallpaper
    theme, so all tone differences are expressed as alpha: the wave itself at
    full opacity, the same path twice underneath at low alpha for the halo.
    Deliberately NO gradients here — a monochrome layer must read as one ink.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M25,54 C30.5,54 32,38 38,38 C44,38 45.5,70 51.5,70 C57.5,70 59,31 65,31 C71,31 72.5,54 78,54"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="13"
        android:strokeAlpha="0.25"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <path
        android:pathData="M25,54 C30.5,54 32,38 38,38 C44,38 45.5,70 51.5,70 C57.5,70 59,31 65,31 C71,31 72.5,54 78,54"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7"
        android:strokeAlpha="0.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <path
        android:pathData="M25,54 C30.5,54 32,38 38,38 C44,38 45.5,70 51.5,70 C57.5,70 59,31 65,31 C71,31 72.5,54 78,54"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
