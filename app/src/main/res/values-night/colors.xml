<resources>
    <!--
        Dark-mode adaptation of the window/splash background: the platform
        picks the -night variant when the device is in dark mode, so the
        splash and cold-start window deepen the midnight navy slightly. The
        launcher icon's gradient background layer is unaffected; the
        themed-icon monochrome layer handles contrast on API 33+.
    -->
    <color name="ic_launcher_background">#14234A</color>
