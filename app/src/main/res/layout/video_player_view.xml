<?xml version="1.0" encoding="utf-8"?>
<!--
    Attached-video page (plan Task 22): PlayerView for the shared-session
    player. surface_type=texture_view composites through the regular view
    pipeline — SurfaceView buffers are not captured by screencap on the QA
    emulator (gfxstream quirk), and the plan's QA evidence is screenshots.
    The controller is custom (Compose overlay): use_controller=false.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit" />
